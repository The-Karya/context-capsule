{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.The-Karya/context-capsule",
  "title": "Context Capsule",
  "description": "Turn your work into capsules any AI can continue from. Local only, nothing uploaded.",
  "repository": {
    "url": "https://github.com/The-Karya/context-capsule",
    "source": "github",
    "subfolder": "mcp"
  },
  "websiteUrl": "https://github.com/The-Karya/context-capsule",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "context-capsule-mcp",
      "version": "0.1.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "CONTEXT_CAPSULE_HOME",
          "description": "Where Context Capsule keeps its data (default ~/.context-capsule)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
